rules_version = '2';

// Source of truth for the Cloud Firestore rules in the Firebase console.
// Publish this same content after changing it in the console.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdministrator() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "active"
        && (
          !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAny(["disabled"])
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.disabled == false
        );
    }

    function isActiveMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "active"
        && (
          !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAny(["disabled"])
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.disabled == false
        );
    }

    function validYear(value) {
      return value is int && value >= 2000 && value <= 2100;
    }

    function validAmount(value, allowZero) {
      return value is int
        && value >= (allowZero ? 0 : 1)
        && value <= 999999999;
    }

    function validBudget(data) {
      return data.keys().hasOnly([
          "year", "category", "amount", "note", "createdAt", "updatedAt", "updatedBy"
        ])
        && validYear(data.year)
        && data.category is string && data.category.size() > 0 && data.category.size() <= 80
        && validAmount(data.amount, true)
        && data.note is string && data.note.size() <= 500
        && data.updatedBy == request.auth.uid;
    }

    function validTransaction(data) {
      return data.keys().hasOnly([
          "year", "date", "type", "category", "title", "amount", "note", "source",
          "sourceId", "createdAt", "updatedAt", "updatedBy"
        ])
        && validYear(data.year)
        && data.date is string && data.date.size() == 10
        && data.type in ["income", "expense"]
        && data.category is string && data.category.size() > 0 && data.category.size() <= 80
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && validAmount(data.amount, false)
        && data.note is string && data.note.size() <= 500
        && data.updatedBy == request.auth.uid;
    }

    function validAnnualFee(data) {
      return data.keys().hasOnly([
          "year", "memberUid", "email", "memberName", "organizationName", "amount",
          "paid", "exempt", "paidDate", "note", "receiptNumber", "createdAt", "updatedAt", "updatedBy"
        ])
        && validYear(data.year)
        && data.memberUid is string && data.memberUid.size() > 0
        && data.email is string && data.email.size() <= 254
        && data.memberName is string && data.memberName.size() > 0 && data.memberName.size() <= 80
        && data.organizationName is string && data.organizationName.size() <= 120
        && validAmount(data.amount, true)
        && data.paid is bool && data.exempt is bool && !(data.paid && data.exempt)
        && data.paidDate is string
        && ((!data.paid && data.paidDate == "") || (data.paid && data.paidDate.size() == 10))
        && data.note is string && data.note.size() <= 500
        && data.updatedBy == request.auth.uid;
    }

    function validSecurityDeviceRequest(data) {
      return data.keys().hasOnly([
          "uid", "email", "deviceId", "environmentSignature", "userAgent",
          "platform", "screen", "timezone", "path", "status",
          "firstSeenAt", "lastSeenAt", "attemptCount"
        ])
        && data.uid is string
        && data.email is string && data.email.size() <= 254
        && data.deviceId is string && data.deviceId.size() >= 16 && data.deviceId.size() <= 120
        && data.environmentSignature is string && data.environmentSignature.size() <= 120
        && data.userAgent is string && data.userAgent.size() <= 500
        && data.platform is string && data.platform.size() <= 80
        && data.screen is string && data.screen.size() <= 40
        && data.timezone is string && data.timezone.size() <= 80
        && data.path is string && data.path.size() <= 300
        && data.status == "blocked"
        && data.attemptCount is int && data.attemptCount >= 1;
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdministrator());
      allow list: if isAdministrator();

      // A registrant may only create their own, pending, non-admin record.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.approved == false
        && request.resource.data.isAdmin == false
        && request.resource.data.status == "pending"
        && request.resource.data.registrationDeviceId is string
        && request.resource.data.registrationDeviceId.size() >= 16
        && request.resource.data.registrationDeviceId.size() <= 120
        && request.resource.data.registrationEnvironmentSignature is string
        && request.resource.data.registrationEnvironmentSignature.size() <= 120
        && request.resource.data.registrationUserAgent is string
        && request.resource.data.registrationUserAgent.size() <= 500
        && request.resource.data.registrationPlatform is string
        && request.resource.data.registrationPlatform.size() <= 80
        && request.resource.data.registrationLanguage is string
        && request.resource.data.registrationLanguage.size() <= 30
        && request.resource.data.registrationScreen is string
        && request.resource.data.registrationScreen.size() <= 40
        && request.resource.data.registrationTimezone is string
        && request.resource.data.registrationTimezone.size() <= 80
        && request.resource.data.registrationIpAddress is string
        && request.resource.data.registrationIpAddress.size() <= 64
        && request.resource.data.registrationCountryCode is string
        && request.resource.data.registrationCountryCode.size() <= 8;

      // Non-admin users can change their display email and record their own
      // server-generated login time. Arbitrary client timestamps are rejected.
      allow update: if isAdministrator() || (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["email", "lastLoginAt"])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["lastLoginAt"])
          || request.resource.data.lastLoginAt == request.time
        )
      );
      allow delete: if isAdministrator();
    }

    // Search-safe photo sharing directory. It intentionally contains none of
    // the role, audit, login or administrator-only fields from /users.
    match /photo_member_directory/{userId} {
      allow read: if isAdministrator() || (
        isActiveMember()
        && resource.data.active == true
      );
      allow create, update: if isAdministrator()
        && request.resource.data.keys().hasOnly(["email", "displayName", "active", "updatedAt"])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 254
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 200
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdministrator();
    }

    match /expenses/{document=**} {
      allow read, write: if isAdministrator();
    }

    match /payments/{document=**} {
      allow read, write: if isAdministrator();
    }

    match /budgets/{documentId} {
      allow read, delete: if isAdministrator();
      allow create, update: if isAdministrator() && validBudget(request.resource.data);
    }

    match /transactions/{documentId} {
      allow read, delete: if isAdministrator();
      allow create, update: if isAdministrator() && validTransaction(request.resource.data);
    }

    match /annual_fees/{documentId} {
      allow read, delete: if isAdministrator();
      allow create, update: if isAdministrator() && validAnnualFee(request.resource.data);
    }

    // Internal notes are separate from user documents so that users cannot read them.
    match /admin_notes/{document=**} {
      allow read, write: if isAdministrator();
    }

    // Browser-side operational telemetry. Users may only append their own
    // records; all inspection and deletion remains administrator-only.
    match /system_events/{eventId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type is string
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdministrator();
      allow update: if false;
    }

    match /login_events/{eventId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "success"
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdministrator();
      allow update: if false;
    }

    match /system_sessions/{sessionId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.sessionId is string;
      allow get: if signedIn() && (resource.data.uid == request.auth.uid || isAdministrator());
      allow list: if isAdministrator();
      allow update: if isAdministrator() || (
        signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "email", "active", "path", "title", "userAgent", "platform",
          "language", "screen", "timezone", "deviceId", "environmentSignature",
          "ipAddress", "countryCode", "networkEdge", "lastSeenAt"
        ])
      );
      allow delete: if isAdministrator();
    }

    match /system_audit/{auditId} {
      allow read, create, delete: if isAdministrator();
      allow update: if false;
    }

    // Administrator-confirmed browser devices used as an additional identity
    // signal when IP addresses change. Members cannot trust their own devices.
    match /security_trusted_devices/{deviceId} {
      allow get: if isAdministrator() || (
        signedIn() && resource.data.uid == request.auth.uid
      );
      allow list: if isAdministrator();
      allow create, update, delete: if isAdministrator();
    }

    // Unrecognized devices are blocked before protected pages are revealed.
    // Members may only create/update the alert for their own account; decisions
    // and deletion remain administrator-only.
    match /security_device_requests/{requestId} {
      allow get: if isAdministrator() || (
        signedIn() && resource.data.uid == request.auth.uid
      );
      allow list: if isAdministrator();
      allow create: if isActiveMember()
        && request.resource.data.uid == request.auth.uid
        && validSecurityDeviceRequest(request.resource.data)
        && request.resource.data.firstSeenAt == request.time
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.attemptCount == 1;
      allow update: if isActiveMember()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.deviceId == resource.data.deviceId
        && validSecurityDeviceRequest(request.resource.data)
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.attemptCount == resource.data.attemptCount + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "email", "environmentSignature", "userAgent", "platform", "screen",
          "timezone", "path", "lastSeenAt", "attemptCount"
        ]);
      allow update, delete: if isAdministrator();
    }

    match /system_monitor_results/{resultId} {
      allow read, write: if isAdministrator();
    }
  }
}
