[Unit]
Description=TAYUNET Photo Archive API
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/tayunet-photo-archive start
ExecStop=/usr/local/sbin/tayunet-photo-archive stop
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
