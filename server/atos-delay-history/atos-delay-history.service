[Unit]
Description=Tayunet ATOS station delay history collector and API
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=atos-history
Group=atos-history
EnvironmentFile=/etc/atos-delay-history.env
ExecStart=/opt/atos-delay-history/atos_delay_history.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/atos-delay-history

[Install]
WantedBy=multi-user.target
