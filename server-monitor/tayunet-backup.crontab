SHELL=/bin/bash
PATH=/home/yoshi/.local/bin:/usr/local/bin:/usr/bin:/bin

# Local encrypted HDD backup every six hours.
15 0,6,12,18 * * * /home/yoshi/services/tayunet-server-monitor/backup.sh local

# Encrypted Google Drive backup every day at 03:00.
0 3 * * * /home/yoshi/services/tayunet-server-monitor/backup.sh cloud
